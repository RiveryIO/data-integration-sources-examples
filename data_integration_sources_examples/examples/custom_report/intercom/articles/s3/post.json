{
  "name": "MCP_v2_Intercom Bigquery v2 - Articles_river_copied",
  "kind": "main_river",
  "type": "source_to_target",
  "group_id": "<GROUP_ID>",
  "metadata": {
    "description": "",
    "river_status": "active"
  },
  "properties": {
    "properties_type": "source_to_target",
    "source": {
      "name": "intercom",
      "connection_id": "<SOURCE_CONNECTION_ID>",
      "run_type": "regular",
      "cdc_settings": null,
      "additional_settings": {
        "connection_type": "intercom",
        "extract_method": "all",
        "quote": "\"",
        "required_mapping_flag": false,
        "delimiter": ",",
        "fz_partition": "d",
        "source_format": "NEWLINE_DELIMITED_JSON",
        "fz_batched": true,
        "report": "articles",
        "gzipTypeMust": null
      }
    },
    "target": {
      "name": "s3",
      "connection_id": "<TARGET_CONNECTION_ID>",
      "single_table_settings": null,
      "path": "<YOUR_PATH>",
      "partitioned_kind": "by_day",
      "fz_loading_mode": "auto-period",
      "convert_file_type": null,
      "bucket_name": "<YOUR_BUCKET_NAME>"
    },
    "schemas": []
  },
  "settings": {
    "run_timeout_seconds": null,
    "notification": {
      "warning": {
        "email": "{DEFAULT_EMAIL_GROUP}",
        "is_enabled": false,
        "execution_time_limit_seconds": null
      },
      "failure": {
        "email": "{DEFAULT_EMAIL_GROUP}",
        "is_enabled": false,
        "execution_time_limit_seconds": null
      },
      "run_threshold": {
        "email": "{DEFAULT_EMAIL_GROUP}",
        "is_enabled": false,
        "execution_time_limit_seconds": 0
      }
    }
  },
  "schedulers": []
}