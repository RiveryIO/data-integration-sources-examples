      "name": "google_analytics",
      "connection_id": "<SOURCE_CONNECTION_ID>",
      "connection_name": "<YOUR_CONNECTION_NAME>",
      "run_type": "predefined_report",
      "cdc_settings": null,
      "additional_settings": {
        "accounts_ids": {
          "__input__": {
            "kind": "all_or_subset",
            "prompt": "All GA4 accounts, or specific ones? Leave as-is for all. Each entry is a bare GA4 Account ID like \"12345678\".",
            "value_type": "string_list",
            "default": []
          }
        },
        "utc_offset": 0,
        "extract_api": "ga4",
        "connection_type": "ganalytics",
        "ga4_advanced_filters": false,
        "source_format": "CSV",
        "fz_partition": "d",
        "cross_reports_ga4_accounts": {
          "__input__": {
            "kind": "all_or_subset",
            "prompt": "(Cross-report mode) All GA4 accounts, or specific ones? Leave as-is for all. Only used when selecting via cross-reports instead of accounts_ids.",
            "value_type": "object_list",
            "element_shape": {
              "id": "",
              "name": ""
            },
            "default": []
          }
        },
        "properties_type": "properties_ids",
        "time_period_cohort": "last_7_days",
        "gzipTypeMust": null,
        "fz_path": "<YOUR_FZ_PATH>",
        "extract_method": "all",
        "account_type": "accounts_ids",
        "profile_type": "profiles_ids",
        "quote": "\"",
        "properties_ids": {
          "__input__": {
            "kind": "all_or_subset",
            "prompt": "All GA4 properties of the selected account(s), or specific ones? Leave as-is for all. Each entry is a bare GA4 Property ID like \"987654321\".",
            "value_type": "string_list",
            "default": []
          }
        },
        "fz_batched": true,
        "report": "ga4_standard",
        "cohort_size": "day",
        "profiles_from_api": true,
        "delimiter": ",",
        "cross_reports_ga4_properties": {
          "__input__": {
            "kind": "all_or_subset",
            "prompt": "(Cross-report mode) All GA4 properties, or specific ones? Leave as-is for all. Each entry pairs a property with its parent account. Only used in cross-report mode.",
            "value_type": "object_list",
            "element_shape": {
              "account_id": "",
              "account_name": "",
              "id": "",
              "name": ""
            },
            "default": []
          }
        }
      }
    },
    "target": {
      "name": "snowflake",
